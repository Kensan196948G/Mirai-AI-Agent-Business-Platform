# Mirai AgentOS — 環境変数（.env 自体は Git 管理しない。値の例のみ記載）

# postgres://<role>:<password>@127.0.0.1:5432/<database>
DATABASE_URL=postgres://mira_agent_os_app:CHANGE_ME@127.0.0.1:5432/mira_agent_os

# セッション Cookie の署名鍵（HMAC-SHA256）。32 バイト以上のランダム値を使うこと。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=CHANGE_ME

# バックエンドの待受ポート（ループバックのみで待受し、公開は Cloudflare Tunnel 経由とする）
PORT=18860

# production | mvp — ログ・Cookie の Secure 属性判定に使う
NODE_ENV=production

# --- AI相談（Chat）の実LLM接続（任意。未設定なら従来どおりルールベース応答のみで動作する） ---
# 空のままなら何も変わらない。設定する場合は production secret 追加として
# Approval PR の Y/N 承認を経てから .env へ反映すること（Git へは絶対にコミットしない）。
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 月間ソフトキャップ（USD）。超過した月はルールベース応答へ自動フォールバックする。
LLM_MONTHLY_CAP_USD=5.00
# DeepSeekのトークン単価目安（$ / 1Mトークン）。実際の価格は
# https://platform.deepseek.com/api-docs/pricing を都度確認して更新すること。
LLM_PRICE_INPUT_PER_1M=0.27
LLM_PRICE_OUTPUT_PER_1M=1.10
