{
  "type": "object",
  "required": [
    "items",
    "unknowns",
    "assumptions",
    "requires_human_review",
    "artifact_id",
    "artifact_code"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "unknown"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "based_on": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "artifact_id": {
      "type": "integer"
    },
    "artifact_code": {
      "type": "string"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
