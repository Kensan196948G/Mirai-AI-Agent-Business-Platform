{
  "type": "object",
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "source_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "public_only",
        "authorized"
      ]
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
