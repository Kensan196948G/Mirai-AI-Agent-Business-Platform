{
  "type": "object",
  "required": [
    "issues",
    "unknowns",
    "requires_human_review",
    "requires_expert_review",
    "artifact_id",
    "artifact_code"
  ],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "finding",
          "severity"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "requires_expert_review": {
      "type": "boolean"
    },
    "artifact_id": {
      "type": "integer"
    },
    "artifact_code": {
      "type": "string"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
