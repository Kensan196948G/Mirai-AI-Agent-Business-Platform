{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["query", "candidates"],
  "properties": {
    "query": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_record_id", "title", "summary"],
        "properties": {
          "source_record_id": { "type": "integer" },
          "title": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
