{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "knowledge_candidate_id",
    "requires_human_review"
  ],
  "properties": {
    "knowledge_candidate_id": {
      "type": "integer"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "conflicts": {
      "type": "array"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_human_review": {
      "type": "boolean",
      "const": true
    },
    "artifact_id": {
      "type": "integer",
      "description": "artifact.write-draft で保存した成果物のID（Runtimeが付与）"
    },
    "artifact_code": {
      "type": "string"
    }
  }
}
