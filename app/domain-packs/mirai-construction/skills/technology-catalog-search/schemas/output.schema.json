{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["candidates", "unknowns"],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_record_id", "title", "summary", "evidence_type"],
        "additionalProperties": false,
        "properties": {
          "source_record_id": { "type": "integer" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "evidence_type": { "type": "string" }
        }
      }
    },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
