{
  "type": "object",
  "required": [
    "references",
    "issues",
    "unknowns"
  ],
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_record_id",
          "title"
        ],
        "properties": {
          "source_record_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "version": {},
          "published_at": {},
          "effective_to": {},
          "source_type": {},
          "canonical_url": {}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_id": {
      "type": "integer"
    },
    "artifact_code": {
      "type": "string"
    },
    "requires_human_review": {
      "type": "boolean"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
