# /etc/systemd/system/mira-agent-os-api.service
[Unit]
Description=Mirai AgentOS API (mirai-agent-os.mirai-dx-platform.com, local Postgres backend)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/Projects/Mirai-DX-Project/Mirai-AI-Agent-Business-Platform/app
EnvironmentFile=/home/kensan/Projects/Mirai-DX-Project/Mirai-AI-Agent-Business-Platform/app/.env
ExecStart=/home/kensan/.nvm/versions/node/v22.22.3/bin/node src/server.js
Restart=on-failure
RestartSec=5

# AI相談（Chat）からDeepSeek API（外部）を呼び出すため、ループバック限定は撤廃した
# （2026-09-08、ユーザー承認済み）。DBは引き続きUnix socket/loopbackのみで運用する。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
